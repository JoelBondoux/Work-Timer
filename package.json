{
  "name": "work-timer",
  "version": "1.3.32",
  "description": "A zero-cost, local-first work timer and billing tool for solo contractors. Control via natural language through any MCP-compatible LLM client or CLI.",
  "type": "module",
  "main": "./dist/mcp/server.js",
  "bin": {
    "work-timer": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:production": "node ./check-production-readiness.mjs",
    "start:mcp": "node dist/mcp/server.js",
    "start:cli": "node dist/cli/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "timer",
    "billing",
    "contractor",
    "freelance",
    "mcp",
    "time-tracking",
    "invoicing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "path-to-regexp": "8.4.0",
    "brace-expansion@^1.1.7": "1.1.13",
    "brace-expansion@^2.0.1": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
